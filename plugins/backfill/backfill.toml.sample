# The commits 'jsa backfill' measures (copy this file to backfill.toml, next to it). In any order: each run is placed
# at the date of its commit in the trends of the report. A commit already measured is skipped.

[[commits]]
commit = "4f2a9c1"                  # a commit hash, a tag or a branch of the repository of your addons

[[commits]]
commit = "v2.0"
event = "Release 2.0"               # optional: an event, at the date of this commit

# Events at a date of their own (also possible by hand in codebase_analysis/history.jsonl)
[[events]]
date = "2025-09-01"
event = "Two developers joined"

# Optional: the profile of config.toml that runs each Odoo version. By default, the only profile whose Odoo has the
# version written in the manifests of the commit ("17.0.1.0.0": Odoo 17).
# [profiles]
# 17 = "17"
# 19 = "19"
