# The history of the codebase report: the commits 'jsa backfill' records, and the events of its trend (copy this file
# to backfill.toml, next to it; in a project, in its .jsa/ folder). In any order: each commit is placed at its date in
# the trend. A commit already recorded is skipped; one taken out of this file is forgotten. 'jsa structure' never adds
# to the history: to record today's code, add its commit (or a tag) here and run 'jsa backfill'.

[[commits]]
commit = "4f2a9c1"                  # a commit hash, a tag or a branch of the repository of your addons

[[commits]]
commit = "v2.0"
event = "Release 2.0"               # optional: an event, at the date of this commit

# Events at a date of their own
[[events]]
date = "2025-09-01"
event = "Two developers joined"

# Optional: the profile of config.toml that runs each Odoo version. By default, the only profile whose Odoo has the
# version written in the manifests of the commit ("17.0.1.0.0": Odoo 17).
# [profiles]
# 17 = "17"
# 19 = "19"
